# =============================================================================
# Copy to application-local.yml and fill in. The real file is gitignored.
# Run with: mvn spring-boot:run -Dspring-boot.run.profiles=local
# =============================================================================
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/medibridge?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
    username: root
    password: "YOUR_MYSQL_PASSWORD"

medibridge:
  jwt:
    # Must be at least 32 bytes for HS256.
    secret: change-this-to-a-long-random-string-at-least-32-chars

  mail:
    # false logs emails to the console instead of sending them.
    enabled: false

  razorpay:
    # Test keys from dashboard.razorpay.com (Test Mode > Settings > API Keys).
    # Leave blank to fall back to simulated payments.
    key-id: ""
    key-secret: ""

  google:
    # OAuth 2.0 Web client ID. Leave blank to disable Google Sign-In.
    client-id: ""
