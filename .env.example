# Copy to .env (gitignored) and fill in before running:
#   docker compose up --build

# --- Database ---
DB_NAME=medibridge
DB_PASSWORD=change-me-strong-password

# --- Auth ---
# >= 32 bytes.
JWT_SECRET=change-me-min-32-bytes-long-secret

# Two DISTINCT shared secrets - do not reuse one for both:
# Spring backend <-> chat-service/notify-service internal calls.
SPRING_INTERNAL_API_KEY=change-me-spring-internal-key
# Gateway <-> chat-service internal calls.
GATEWAY_INTERNAL_API_KEY=change-me-gateway-internal-key

# --- Mail (optional; MAIL_ENABLED=false logs emails to console instead) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@medibridge.com

# --- SMS/WhatsApp via Twilio (optional; SMS_ENABLED=false logs instead) ---
SMS_ENABLED=false
SMS_CHANNEL=WHATSAPP
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_SMS=
TWILIO_WHATSAPP_FROM=+14155238886

# --- Google Sign-In (optional; blank hides the button) ---
GOOGLE_CLIENT_ID=

# --- Razorpay (optional; blank falls back to simulated payment form) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Chat service (Groq LLM) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=openai/gpt-oss-120b
