{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__Claude_Browser",
      "mcp__claude-in-chrome",

      "Bash(npm run dev:*)",
      "Bash(npm start:*)",
      "Bash(npm run preview:*)",
      "Bash(yarn dev:*)",
      "Bash(pnpm dev:*)",
      "Bash(npx vite:*)",
      "Bash(vite:*)",
      "Bash(mvn spring-boot:run:*)",
      "Bash(./mvnw spring-boot:run:*)",
      "PowerShell(npm run dev:*)",
      "PowerShell(npm start:*)",
      "PowerShell(mvn spring-boot:run:*)",

      "Read(./medibridge-frontend/node_modules/**)",
      "Read(./medibridge-frontend/dist/**)",
      "Read(./medibridge-frontend/package-lock.json)",
      "Read(./medibridge-frontend/.vite/**)",

      "Read(./medibridge-backend/target/**)",
      "Read(./medibridge-backend/.mvn/**)",
      "Read(./medibridge-backend/mvnw)",
      "Read(./medibridge-backend/mvnw.cmd)",

      "Read(./.git/**)",

      "Read(./medibridge-backup-*.sql)",
      "Read(./**/storage/**)",
      "Read(./**/sample-output/**)",
      "Read(./**/*.log)",
      "Read(./**/logs/**)",
      "Read(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./**/*.iml)"
    ]
  }
}
